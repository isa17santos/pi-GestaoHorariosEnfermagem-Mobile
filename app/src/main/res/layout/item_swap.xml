<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white"
    app:strokeColor="#1A000000"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header: nome (2 linhas) + badge + data -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tv_counterparty"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="2"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tv_status_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:layout_marginStart="8dp"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_badge_rounded" />

            <TextView
                android:id="@+id/tv_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textSize="12sp"
                android:textColor="@color/text_muted" />
        </LinearLayout>

        <!--
            Grid de turnos: coluna esquerda | ícone central | coluna direita.
            O ícone fica sempre entre as duas colunas, centrado verticalmente.
            Troca simples: cada coluna tem 1 card.
            Troca dupla:   cada coluna tem 2 cards (card_*_1 visível).
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Coluna esquerda: turnos oferecidos -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_offered_0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#F8F5FF"
                    app:strokeColor="#E6E0F5"
                    app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="10dp">
                        <TextView android:id="@+id/tv_label_offered_0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:textStyle="bold" android:textColor="@color/text_muted" android:layout_marginBottom="4dp"/>
                        <TextView android:id="@+id/tv_date_offered_0"  android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/text_primary"/>
                        <TextView android:id="@+id/tv_type_offered_0"  android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/text_primary"/>
                        <TextView android:id="@+id/tv_owner_offered_0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/text_muted"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Segundo card esquerdo: apenas troca dupla -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_offered_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:visibility="gone"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#F8F5FF"
                    app:strokeColor="#E6E0F5"
                    app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="10dp">
                        <TextView android:id="@+id/tv_label_offered_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:textStyle="bold" android:textColor="@color/text_muted" android:layout_marginBottom="4dp"/>
                        <TextView android:id="@+id/tv_date_offered_1"  android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/text_primary"/>
                        <TextView android:id="@+id/tv_type_offered_1"  android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/text_primary"/>
                        <TextView android:id="@+id/tv_owner_offered_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/text_muted"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Ícone central: sempre entre as duas colunas, centrado verticalmente -->
            <ImageView
                android:id="@+id/iv_swap_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginHorizontal="6dp"
                android:layout_gravity="center_vertical"
                android:src="@drawable/ic_shift_swaps"
                app:tint="@color/primary_strong" />

            <!-- Coluna direita: turnos pretendidos/a receber -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_requested_0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#F8F5FF"
                    app:strokeColor="#E6E0F5"
                    app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="10dp">
                        <TextView android:id="@+id/tv_label_requested_0"  android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:textStyle="bold" android:textColor="@color/text_muted" android:layout_marginBottom="4dp"/>
                        <TextView android:id="@+id/tv_date_requested_0"   android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/text_primary"/>
                        <TextView android:id="@+id/tv_type_requested_0"   android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/text_primary"/>
                        <TextView android:id="@+id/tv_owner_requested_0"  android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/text_muted"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Segundo card direito: apenas troca dupla -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_requested_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:visibility="gone"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#F8F5FF"
                    app:strokeColor="#E6E0F5"
                    app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="10dp">
                        <TextView android:id="@+id/tv_label_requested_1"  android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:textStyle="bold" android:textColor="@color/text_muted" android:layout_marginBottom="4dp"/>
                        <TextView android:id="@+id/tv_date_requested_1"   android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/text_primary"/>
                        <TextView android:id="@+id/tv_type_requested_1"   android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/text_primary"/>
                        <TextView android:id="@+id/tv_owner_requested_1"  android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/text_muted"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>

        <!-- Botões de ação -->
        <LinearLayout
            android:id="@+id/ll_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:gravity="end">

            <!-- Cancelar: igual ao botão "Voltar" -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cancel_swap"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:text="@string/btn_cancel_swap"
                android:textColor="@color/primary_strong"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:visibility="gone"
                android:backgroundTint="#F8F5FF"
                app:strokeColor="#E6E0F5"
                app:strokeWidth="1dp"
                app:cornerRadius="28dp"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton" />

            <!-- Aceitar: igual ao botão "Novo pedido" -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_accept_swap"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/btn_accept_swap"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:visibility="gone"
                app:backgroundTint="@null"
                android:background="@drawable/btn_login_gradient"
                app:cornerRadius="28dp"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton" />

            <!-- Rejeitar: igual ao botão "Voltar" -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_reject_swap"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/btn_reject_swap"
                android:textColor="@color/primary_strong"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:visibility="gone"
                android:backgroundTint="#F8F5FF"
                app:strokeColor="#E6E0F5"
                app:strokeWidth="1dp"
                app:cornerRadius="28dp"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton" />

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
