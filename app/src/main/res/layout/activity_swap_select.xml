<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <include layout="@layout/layout_navbar" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_back"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="32dp"
                android:text="@string/back"
                android:textAllCaps="false"
                android:textColor="#7C3AED"
                android:textStyle="bold"
                app:icon="@drawable/ic_arrow_back"
                app:iconTint="#7C3AED"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                android:backgroundTint="#F8F5FF"
                app:strokeColor="#E6E0F5"
                app:strokeWidth="1dp"
                app:cornerRadius="28dp"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"/>

            <TextView
                android:id="@+id/tv_page_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="#1E293B" />

            <TextView
                android:id="@+id/tv_page_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#64748B"
                android:textSize="16sp"
                android:layout_marginBottom="16dp" />

            <!-- Info banner -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/banner_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#267C3AED"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="#0D7C3AED">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_info_circle"
                        app:tint="#7C3AED" />

                    <TextView
                        android:id="@+id/tv_banner_text"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:textSize="13sp"
                        android:lineSpacingExtra="2dp"
                        android:textColor="#1E293B" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Week navigation controls -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_today"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="@string/today"
                    android:textAllCaps="false"
                    android:textColor="#2D2054"
                    android:textStyle="bold"
                    android:paddingHorizontal="16dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:strokeColor="#337C3AED"
                    app:strokeWidth="1.5dp"
                    app:cornerRadius="12dp"
                    app:backgroundTint="#FFFFFF"
                    app:rippleColor="#1A7C3AED"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_prev"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="12dp"
                    android:padding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:icon="@drawable/ic_chevron_left"
                    app:iconTint="#2D2054"
                    app:iconSize="20dp"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:strokeColor="#337C3AED"
                    app:strokeWidth="1.5dp"
                    app:cornerRadius="12dp"
                    app:backgroundTint="#FFFFFF"
                    app:rippleColor="#1A7C3AED"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_next"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:padding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:icon="@drawable/ic_chevron_left"
                    app:iconTint="#2D2054"
                    app:iconSize="20dp"
                    android:rotation="180"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:strokeColor="#337C3AED"
                    app:strokeWidth="1.5dp"
                    app:cornerRadius="12dp"
                    app:backgroundTint="#FFFFFF"
                    app:rippleColor="#1A7C3AED"/>

                <TextView
                    android:id="@+id/tv_week_range"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:textStyle="bold"
                    android:textColor="#2D2054"
                    android:textSize="17sp" />
            </LinearLayout>

            <!-- Calendar grid -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E2E8F0"
                app:cardBackgroundColor="#FFFFFF">
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:id="@+id/grid_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:minWidth="800dp"
                        android:background="@android:color/transparent">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:background="@android:color/transparent">
                            <View android:layout_width="60dp" android:layout_height="1dp" />
                            <LinearLayout
                                android:id="@+id/row_days_header"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:minHeight="60dp"
                            android:background="@android:color/transparent">
                            <TextView
                                android:id="@+id/tv_allday_label"
                                android:layout_width="60dp"
                                android:layout_height="match_parent"
                                android:text="@string/all_day_label"
                                android:gravity="center"
                                android:textSize="10sp"
                                android:textColor="#64748B"
                                android:textStyle="bold"
                                android:padding="4dp"/>
                            <LinearLayout
                                android:id="@+id/row_allday_content"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal" />
                        </LinearLayout>

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <LinearLayout
                                android:id="@+id/col_hours"
                                android:layout_width="60dp"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:background="@android:color/transparent"/>
                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_toEndOf="@id/col_hours">
                                <LinearLayout
                                    android:id="@+id/grid_background_lines"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical" />
                                <LinearLayout
                                    android:id="@+id/row_shift_columns"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal" />
                            </FrameLayout>
                        </RelativeLayout>
                    </LinearLayout>
                </HorizontalScrollView>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <ProgressBar
        android:id="@+id/loader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
