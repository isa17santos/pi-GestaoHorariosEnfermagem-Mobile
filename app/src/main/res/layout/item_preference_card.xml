<?xml version="1.0" encoding="utf-8"?>
<!-- Preference Card Item - Inflated dynamically in profile preferences container -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white"
    app:strokeColor="#E6E0F5"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header Row: Month/Year + Chevron + Delete Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_pref_month_year"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                tools:text="Maio 2026" />

            <ImageButton
                android:id="@+id/btn_pref_chevron"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_action_btn"
                android:src="@drawable/ic_chevron_down"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:contentDescription="Expandir/Colapsar" />

            <ImageButton
                android:id="@+id/btn_pref_delete"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_action_btn_danger"
                android:src="@drawable/ic_delete"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:contentDescription="Eliminar Preferência" />
        </LinearLayout>

        <!-- Subtitle — text set dynamically in displayPreferences() via isEn -->
        <TextView
            android:id="@+id/tv_pref_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            android:layout_marginTop="4dp"
            tools:text="Preferências Mensais" />

        <!-- Preference pills flow side by side, wrapping to the next line as needed -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/cg_pref_pills"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:chipSpacingHorizontal="8dp"
            app:chipSpacingVertical="4dp" />

        <!-- Notes -->
        <TextView
            android:id="@+id/tv_pref_notes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text_muted"
            android:textSize="14sp"
            android:visibility="gone"
            tools:text="Notas: Prefiro trabalhar turnos da manhã durante a semana."
            tools:visibility="visible" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

