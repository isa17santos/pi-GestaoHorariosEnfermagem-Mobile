<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <include layout="@layout/layout_navbar" />

        <!-- Botão Voltar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_back"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="32dp"
            android:text="@string/back"
            android:textAllCaps="false"
            android:textColor="@color/primary_strong"
            android:textStyle="bold"
            app:icon="@drawable/ic_arrow_back"
            app:iconTint="@color/primary_strong"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            android:backgroundTint="#F8F5FF"
            app:strokeColor="#E6E0F5"
            app:strokeWidth="1dp"
            app:cornerRadius="28dp"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton" />

        <!-- Título -->
        <TextView
            android:id="@+id/tv_page_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/statistics"
            android:textColor="@color/text_primary"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_page_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:text="@string/admin_statistics_subtitle"
            android:textColor="@color/text_muted"
            android:textSize="16sp" />

        <!-- Secção principal -->
        <LinearLayout
            android:id="@+id/section_stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Mês actual -->
            <TextView
                android:id="@+id/tv_month_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:textColor="@color/primary_strong"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <!-- Card: Qualidade do serviço -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Título do card -->
                    <TextView
                        android:id="@+id/tv_quality_card_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:gravity="center"
                        android:text="@string/stat_quality_title"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- Badge indicador (Bom / Médio / Mau) -->
                    <TextView
                        android:id="@+id/tv_quality_badge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        android:gravity="center"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:text="—"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_quality_badge" />

                    <!-- Barra de progresso tricolor com cantos arredondados -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:layout_marginBottom="6dp"
                        android:background="@drawable/bg_quality_bar"
                        android:clipToOutline="true">

                        <!-- Fundo tricolor -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal">

                            <!-- Zona laranja-escura 0-39 (39%) -->
                            <View
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="39"
                                android:background="@color/quality_bad" />

                            <!-- Zona laranja 40-69 (30%) -->
                            <View
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="30"
                                android:background="@color/quality_medium" />

                            <!-- Zona verde 70-100 (31%) -->
                            <View
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="31"
                                android:background="@color/quality_good" />

                        </LinearLayout>

                        <!-- Marcador da posição do score -->
                        <View
                            android:id="@+id/view_score_marker"
                            android:layout_width="3dp"
                            android:layout_height="14dp"
                            android:layout_gravity="center_vertical"
                            android:background="@color/text_primary" />

                    </FrameLayout>

                    <!-- Pontuação -->
                    <TextView
                        android:id="@+id/tv_quality_score"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:gravity="center"
                        android:text="@string/stat_quality_score_label_empty"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- Nota de calibração -->
                    <TextView
                        android:id="@+id/tv_quality_note"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:text="@string/stat_quality_note"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif"
                        android:textStyle="italic" />

                    <!-- Breakdown: baseado em -->
                    <TextView
                        android:id="@+id/tv_quality_based_on"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/stat_quality_based_on"
                        android:textColor="@color/primary_strong"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- Linhas do breakdown numa TableLayout para alinhamento perfeito -->
                    <TableLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:shrinkColumns="1">

                        <TableRow
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/tv_breakdown_swaps"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="—"
                                android:textColor="@color/primary_strong"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:gravity="end"
                                android:paddingEnd="8dp" />

                            <TextView
                                android:id="@+id/tv_label_breakdown_swaps"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/stat_breakdown_swaps"
                                android:textColor="@color/text_muted"
                                android:textSize="13sp" />

                        </TableRow>

                        <TableRow
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/tv_breakdown_min_nurses"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="—"
                                android:textColor="@color/primary_strong"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:gravity="end"
                                android:paddingEnd="8dp" />

                            <TextView
                                android:id="@+id/tv_label_breakdown_min_nurses"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/stat_breakdown_min_nurses"
                                android:textColor="@color/text_muted"
                                android:textSize="13sp" />

                        </TableRow>

                        <TableRow
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/tv_breakdown_pref_type"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="—"
                                android:textColor="@color/primary_strong"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:gravity="end"
                                android:paddingEnd="8dp" />

                            <TextView
                                android:id="@+id/tv_label_breakdown_pref_type"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/stat_breakdown_pref_type"
                                android:textColor="@color/text_muted"
                                android:textSize="13sp" />

                        </TableRow>

                        <TableRow
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/tv_breakdown_pref_weekend"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="—"
                                android:textColor="@color/primary_strong"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:gravity="end"
                                android:paddingEnd="8dp" />

                            <TextView
                                android:id="@+id/tv_label_breakdown_pref_weekend"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/stat_breakdown_pref_weekend"
                                android:textColor="@color/text_muted"
                                android:textSize="13sp" />

                        </TableRow>

                    </TableLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card: Taxa de Aceitação de Trocas -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:gravity="center_horizontal">

                    <TextView
                        android:id="@+id/tv_acceptance_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp"
                        android:text="@string/stat_acceptance_title"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- Círculo de progresso -->
                    <FrameLayout
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:layout_marginBottom="12dp">

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/progress_acceptance"
                            android:layout_width="120dp"
                            android:layout_height="120dp"
                            android:layout_gravity="center"
                            app:trackThickness="10dp"
                            app:trackColor="#EDE8F8"
                            app:indicatorColor="@color/primary_strong"
                            app:indicatorSize="120dp"
                            android:indeterminate="false"
                            android:progress="0"
                            android:max="100" />

                        <TextView
                            android:id="@+id/tv_acceptance_rate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="—"
                            android:textColor="@color/primary_strong"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                    </FrameLayout>

                    <TextView
                        android:id="@+id/tv_acceptance_legend"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/stat_acceptance_legend"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card: Horas por Enfermeiro -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tv_hours_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/stat_hours_title"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_hours_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="@string/stat_hours_subtitle"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp" />

                    <!-- Cabeçalho da tabela -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingBottom="8dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp">

                        <TextView
                            android:id="@+id/tv_hours_col_name"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/stat_hours_col_name"
                            android:textColor="@color/primary_strong"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_hours_col_hours"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/stat_hours_col_hours"
                            android:textColor="@color/primary_strong"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginBottom="4dp"
                        android:background="#F0EBF8" />

                    <!-- Linhas geradas programaticamente -->
                    <LinearLayout
                        android:id="@+id/ll_nurse_hours"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <!-- Legenda de cores — linha 1: dots + limiar -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <View
                            android:id="@+id/dot_above_avg"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:layout_marginEnd="4dp" />

                        <TextView
                            android:id="@+id/tv_legend_above"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"
                            android:text="@string/stat_hours_legend_above"
                            android:textColor="@color/text_muted"
                            android:textSize="11sp" />

                        <View
                            android:id="@+id/dot_below_avg"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:layout_marginEnd="4dp" />

                        <TextView
                            android:id="@+id/tv_legend_below"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/stat_hours_legend_below"
                            android:textColor="@color/text_muted"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tv_legend_threshold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/stat_hours_legend_threshold"
                            android:textColor="@color/text_muted"
                            android:textSize="11sp" />

                    </LinearLayout>

                    <!-- Legenda — linha 2: média -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/tv_avg_hours"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/primary_strong"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </LinearLayout>
</ScrollView>
