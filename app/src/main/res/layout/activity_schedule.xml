<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- FILHO ÚNICO DO SCROLLVIEW -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <include layout="@layout/layout_navbar" />

            <!-- 3. Botão Voltar  -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_back"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="32dp"
                android:text="Voltar"
                android:textAllCaps="false"
                android:textColor="#7C3AED"
                android:textStyle="bold"
                app:icon="@drawable/ic_arrow_back"
                app:iconTint="#7C3AED"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                android:backgroundTint="#F8F5FF"
                app:strokeColor="#E6E0F5"
                app:strokeWidth="1dp"
                app:cornerRadius="28dp"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"/>

            <!-- 4. Conteúdo da Página (Horário, Banners, Grelha) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/tv_page_title"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="#1E293B" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/tv_page_subtitle"
                android:textColor="#64748B"
                android:textSize="16sp"
                android:layout_marginBottom="24dp" />

            <!-- 5. iCal Banner -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/banner_ical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#267C3AED"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="#0D7C3AED">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_info_circle"
                        app:tint="#7C3AED" />

                    <TextView
                        android:id="@+id/tv_banner_text"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:textSize="13sp"
                        android:lineSpacingExtra="2dp"
                        android:textColor="#1E293B" />

                    <ImageView
                        android:id="@+id/btn_close_banner"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="8dp"
                        android:src="@android:drawable/ic_menu_close_clear_cancel"
                        app:tint="#64748B"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 6. Controlos e Grelha -->
            <!-- Controls (Hoje, Arrows, Range) - Estilo Web -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">

                <!-- Botão Hoje -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_today"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="Hoje"
                    android:textAllCaps="false"
                    android:textColor="#2D2054"
                    android:textStyle="bold"
                    android:paddingHorizontal="16dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:strokeColor="#337C3AED"
                    app:strokeWidth="1.5dp"
                    app:cornerRadius="12dp"
                    app:backgroundTint="#FFFFFF"
                    app:rippleColor="#1A7C3AED"/>

                <!-- Seta Esquerda -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_prev"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="12dp"
                    android:padding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:icon="@drawable/ic_chevron_left"
                    app:iconTint="#2D2054"
                    app:iconSize="20dp"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:strokeColor="#337C3AED"
                    app:strokeWidth="1.5dp"
                    app:cornerRadius="12dp"
                    app:backgroundTint="#FFFFFF"
                    app:rippleColor="#1A7C3AED"/>

                <!-- Seta Direita -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_next"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:padding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:icon="@drawable/ic_chevron_left"
                    app:iconTint="#2D2054"
                    app:iconSize="20dp"
                    android:rotation="180"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:strokeColor="#337C3AED"
                    app:strokeWidth="1.5dp"
                    app:cornerRadius="12dp"
                    app:backgroundTint="#FFFFFF"
                    app:rippleColor="#1A7C3AED"/>

                <!-- Texto da Data -->
                <TextView
                    android:id="@+id/tv_week_range"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="1 - 7 Jun. 2026"
                    android:textStyle="bold"
                    android:textColor="#2D2054"
                    android:textSize="17sp" />
            </LinearLayout>

            <!-- Botões de Ação (iCal, PDF, Imprimir) - Estilo Web -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_ical"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="iCal"
                    android:textAllCaps="false"
                    android:textColor="#7C3AED"
                    android:textStyle="bold"
                    app:icon="@drawable/ic_calendar_nurse"
                    app:iconTint="#7C3AED"
                    app:iconSize="18dp"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:strokeColor="#337C3AED"
                    app:strokeWidth="1.5dp"
                    app:cornerRadius="12dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:backgroundTint="#FFFFFF"/>
            </LinearLayout>

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggle_view"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_view_toggle"
                android:padding="4dp"
                app:singleSelection="true"
                app:selectionRequired="true"
                app:checkedButton="@+id/btn_personal_view">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_personal_view"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="2dp"
                    android:text="Vista Pessoal"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textColor="@color/toggle_text_selector"
                    app:icon="@drawable/ic_person"
                    app:iconTint="@color/toggle_text_selector"
                    app:backgroundTint="@color/toggle_bg_selector"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.RoundedButton"
                    app:elevation="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_global_view"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="2dp"
                    android:text="Vista Global"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textColor="@color/toggle_text_selector"
                    app:icon="@drawable/ic_people"
                    app:iconTint="@color/toggle_text_selector"
                    app:backgroundTint="@color/toggle_bg_selector"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.RoundedButton"
                    app:elevation="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- 7. Legenda de Turnos -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/tv_legend_title"
                android:textStyle="bold"
                android:textColor="#2D2054"
                android:textSize="16sp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cg_shift_legend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="8dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E2E8F0"
                app:cardBackgroundColor="#FFFFFF">
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout android:id="@+id/grid_container" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:minWidth="800dp" android:background="@android:color/transparent">
                        <LinearLayout android:id="@+id/header_days_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:background="@android:color/transparent">
                            <View android:layout_width="60dp" android:layout_height="1dp" />
                            <LinearLayout android:id="@+id/row_days_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:minHeight="60dp" android:background="@android:color/transparent">
                            <TextView android:id="@+id/tv_allday_label" android:layout_width="60dp" android:layout_height="match_parent" android:text="Dia\ninteiro" android:gravity="center" android:textSize="10sp" android:textColor="#64748B" android:textStyle="bold" android:padding="4dp"/>
                            <LinearLayout android:id="@+id/row_allday_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" />
                        </LinearLayout>
                        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                            <LinearLayout android:id="@+id/col_hours" android:layout_width="60dp" android:layout_height="wrap_content" android:orientation="vertical" android:background="@android:color/transparent"/>
                            <FrameLayout android:id="@+id/grid_shifts_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_toEndOf="@id/col_hours">
                                <LinearLayout android:id="@+id/grid_background_lines" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
                                <LinearLayout android:id="@+id/row_shift_columns" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" />
                            </FrameLayout>
                        </RelativeLayout>
                    </LinearLayout>
                </HorizontalScrollView>
            </com.google.android.material.card.MaterialCardView>

            <!-- 8. Distribuição de Turnos por Dia -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="32dp"
                android:padding="16dp"
                android:background="@drawable/bg_view_toggle"
                android:backgroundTint="#087C3AED">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">
                    <View
                        android:layout_width="4dp"
                        android:layout_height="24dp"
                        android:background="#7C3AED" />
                    <TextView
                        android:id="@+id/tv_distribution_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Distribuição de Turnos por Dia"
                        android:textColor="#2D2054"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/cg_daily_distribution"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="40dp"
                    app:chipSpacingHorizontal="24dp"
                    app:chipSpacingVertical="32dp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <ProgressBar
        android:id="@+id/loader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>