<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_agenda_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Left color bar -->
        <View
            android:id="@+id/view_color_bar"
            android:layout_width="5dp"
            android:layout_height="match_parent"
            android:minHeight="64dp" />

        <!-- Main content -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="8dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <!-- Row 1: day + date -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <TextView
                    android:id="@+id/tv_day_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />

                <!-- Badge chip -->
                <TextView
                    android:id="@+id/tv_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_badge_rounded"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- Row 2: date (larger) -->
            <TextView
                android:id="@+id/tv_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <!-- Row 3: shift type + hours -->
            <TextView
                android:id="@+id/tv_shift_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp" />

            <!-- Row 4: candidate breakdown (dayoff only) -->
            <LinearLayout
                android:id="@+id/ll_breakdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="10dp"
                android:paddingTop="10dp"
                android:visibility="gone">

                <!-- top divider drawn via background -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#D8B4FE"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tv_breakdown_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04"
                    android:textColor="#7C3AED"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:id="@+id/ll_breakdown_rows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>

        </LinearLayout>

        <!-- Chevron (dayoff only) -->
        <ImageView
            android:id="@+id/iv_chevron"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="14dp"
            android:src="@drawable/ic_chevron_left"
            android:rotation="180"
            app:tint="#7C3AED"
            android:visibility="gone" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
