<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:startColor="@color/primary_soft"
                android:centerColor="@color/accent_pink"
                android:endColor="@color/accent_peach"
                android:angle="135" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:top="16dp" android:bottom="16dp" android:left="8dp" android:right="8dp">
        <shape><solid android:color="@color/white"/><corners android:radius="999dp"/></shape>
    </item>
    <item android:left="16dp" android:right="16dp" android:top="8dp" android:bottom="8dp">
        <shape><solid android:color="@color/white"/><corners android:radius="999dp"/></shape>
    </item>
    <item android:width="8dp" android:height="8dp" android:top="6dp" android:right="6dp" android:gravity="top|right">
        <shape android:shape="oval"><solid android:color="#F2FFFFFF"/></shape>
    </item>
</layer-list>
