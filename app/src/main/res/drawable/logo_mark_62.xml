<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:startColor="@color/primary_soft"
                android:centerColor="@color/accent_pink"
                android:endColor="@color/accent_peach"
                android:angle="315" /> <!-- Direção top-left para bottom-right -->
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item android:width="34dp" android:height="10dp" android:gravity="center">
        <shape><solid android:color="@color/white"/><corners android:radius="999dp"/></shape>
    </item>
    <item android:width="10dp" android:height="34dp" android:gravity="center">
        <shape><solid android:color="@color/white"/><corners android:radius="999dp"/></shape>
    </item>
    <item android:width="14dp" android:height="14dp" android:top="8dp" android:right="8dp" android:gravity="top|right">
        <shape android:shape="oval"><solid android:color="#F2FFFFFF"/></shape>
    </item>
</layer-list>