<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissão de Internet -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GestaoHorariosEnfermagemMobile"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- Login activity with email and password input fields -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="locale|layoutDirection|keyboard|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Password recovery with email input field -->
        <activity
            android:name=".ForgotPasswordActivity"
            android:configChanges="locale|layoutDirection|orientation|screenSize"
            android:windowSoftInputMode="adjustResize" />


        <!-- Password reset with new password input fields -->
        <activity
            android:name=".ResetPasswordActivity"
            android:exported="true"
            android:configChanges="locale|layoutDirection|orientation|screenSize"
            android:windowSoftInputMode="adjustResize">

            <!-- Intent Filter para Deep Linking -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="http"
                    android:host="@string/config_web_host"
                    android:port="@string/config_web_port"
                    android:pathPrefix="/reset-password" />

            </intent-filter>
        </activity>

        <!-- Dashboard Admin -->
        <activity
            android:name=".AdminDashboardActivity"
            android:configChanges="locale|layoutDirection|orientation|screenSize"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"/>

        <!-- Dashboard Nurse -->
        <activity
            android:name=".NurseDashboardActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="locale|layoutDirection|orientation|screenSize"/>

        <!-- Dashboard Head Nurse -->
        <activity
            android:name=".HeadNurseDashboardActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="locale|layoutDirection|orientation|screenSize" />

        <activity
            android:name=".ProfileActivity"
            android:configChanges="locale|layoutDirection|orientation|screenSize"
            android:windowSoftInputMode="adjustResize"/>

        <!-- Change password with current password and new password input fields -->
        <activity
            android:name=".ChangePasswordActivity"
            android:configChanges="locale|layoutDirection|orientation|screenSize"
            android:windowSoftInputMode="adjustResize" />

        <!-- Cards admin -->
        <!-- Human resources management with search input field -->
        <activity
            android:name=".HumanResourcesActivity"
            android:configChanges="locale|layoutDirection|orientation|screenSize"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".VacationsActivity"
            android:configChanges="locale|layoutDirection|orientation|screenSize"
            android:windowSoftInputMode="adjustResize"/>

        <activity
            android:name=".MedicalLeavesActivity"
            android:configChanges="locale|layoutDirection|orientation|screenSize"
            android:windowSoftInputMode="adjustResize"/>

        <activity
            android:name=".MedicalLeaveCreateActivity"
            android:configChanges="locale|layoutDirection|orientation|screenSize"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".MedicalLeaveEditActivity"
            android:configChanges="locale|layoutDirection|orientation|screenSize"
            android:windowSoftInputMode="adjustResize" />


        <!-- Shift types list with search input field -->
        <activity
            android:name=".ShiftTypesActivity"
            android:configChanges="locale|layoutDirection|orientation|screenSize"
            android:windowSoftInputMode="adjustResize" />

        <!-- Shift type creation with multiple input fields (name, times, duration) -->
        <activity
            android:name=".ShiftTypeCreateActivity"
            android:exported="false"
            android:configChanges="locale|layoutDirection|orientation|screenSize"
            android:windowSoftInputMode="adjustResize" />

        <!-- Shift type editing with multiple input fields (name, times, duration) -->
        <activity
            android:name=".ShiftTypeEditActivity"
            android:exported="false"
            android:configChanges="locale|layoutDirection|orientation|screenSize"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".AdminStatisticsActivity"
            android:configChanges="locale|layoutDirection|orientation|screenSize"
            android:windowSoftInputMode="adjustResize"/>

        <!-- User edit form with name and email input fields -->
        <activity
            android:name=".UserEditActivity"
            android:exported="false"
            android:configChanges="locale|layoutDirection|orientation|screenSize"
            android:windowSoftInputMode="adjustResize" />

        <!-- User creation form with name input field -->
        <activity
            android:name=".UserCreateActivity"
            android:exported="false"
            android:configChanges="locale|layoutDirection|orientation|screenSize"
            android:windowSoftInputMode="adjustResize" />


        <!-- Cards nurse -->
        <activity
            android:name=".ScheduleActivity"
            android:exported="false"
            android:configChanges="locale|layoutDirection|orientation|screenSize"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".SwapsActivity"
            android:exported="false"
            android:configChanges="locale|layoutDirection|orientation|screenSize"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".SwapHistoryActivity"
            android:exported="false"
            android:configChanges="locale|layoutDirection|orientation|screenSize"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".SwapSelectActivity"
            android:exported="false"
            android:configChanges="locale|layoutDirection|orientation|screenSize"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".SwapCreateActivity"
            android:exported="false"
            android:configChanges="locale|layoutDirection|orientation|screenSize"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".NurseStatisticsActivity"
            android:configChanges="locale|layoutDirection|orientation|screenSize"
            android:windowSoftInputMode="adjustResize"/>

        <!-- Cards head nurse -->
        <activity
            android:name=".HeadNurseStatisticsActivity"
            android:configChanges="locale|layoutDirection|orientation|screenSize"
            android:windowSoftInputMode="adjustResize"/>

        <!-- Notifications -->
        <activity
            android:name=".NotificationsActivity"
            android:configChanges="locale|layoutDirection|orientation|screenSize"
            android:windowSoftInputMode="adjustResize"/>
    </application>

</manifest>